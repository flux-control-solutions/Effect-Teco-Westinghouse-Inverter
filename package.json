{
  "name": "@flux-control/effect-teco-westinghouse-inverter",
  "version": "0.7.0",
  "description": "Effect First Typesafe communication library for the Teco WestingHouse A510 Inverter Family",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flux-control-solutions/Effect-Teco-Westinghouse-Inverter.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf ./dist && bun build ./index.ts --outdir ./dist --target node --external effect --external @flux-control/effect-modbus-rs --external modbus-rs --external @flux-control/modbus-schema && tsc --noEmit false --emitDeclarationOnly --outDir ./dist --rootDir . --project tsconfig.build.json",
    "changeset": "changeset",
    "docs": "bun install --cwd tools/typedoc --frozen-lockfile && bun run --cwd \"$PWD/tools/typedoc\" generate",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:staged": "lint-staged --config package.json",
    "lock": "bash tools/refresh-lockfile.sh",
    "prepare": "husky",
    "release": "changeset publish",
    "test": "bun test src/schemas.test.ts src/TecoInverterService.test.ts src/parameters/",
    "test:coverage": "bun test --coverage src/schemas.test.ts src/TecoInverterService.test.ts src/parameters/",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "@flux-control/modbus-schema": "^0.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/language-service": "0.87.4",
    "@effect/platform-bun": "4.0.2",
    "@flux-control/effect-modbus-rs": "^0.8.0",
    "@oxlint/plugins": "1.87.0",
    "@types/bun": "latest",
    "effect": "4.0.2",
    "fallow": "^3.33.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "1.87.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@flux-control/effect-modbus-rs": "^0.8.0",
    "effect": "^4.0.1"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,jsonc,md,mdx,css,scss,html,yaml,yml}": "oxfmt"
  }
}
