{
  "name": "@flux-control/effect-teco-westinghouse-inverter",
  "version": "0.2.0",
  "description": "Effect First Typesafe communication library for the Teco WestingHouse A510 Inverter Family",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flux-control-solutions/Effect-Teco-Westinghouse-Inverter.git"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf ./dist && bun build ./index.ts --outdir ./dist --target node --external effect --external @flux-control/effect-modbus-rs --external modbus-rs --external @flux-control/modbus-schema && tsc --noEmit false --emitDeclarationOnly --outDir ./dist --rootDir . --project tsconfig.build.json",
    "changeset": "changeset",
    "docs": "bun install --cwd tools/typedoc --frozen-lockfile && bun run --cwd \"$PWD/tools/typedoc\" generate",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "release": "changeset publish",
    "test": "bun test src/schemas.test.ts src/parameters/",
    "test:coverage": "bun test --coverage src/schemas.test.ts src/parameters/",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "dependencies": {
    "@flux-control/effect-modbus-rs": "^0.3.0",
    "@flux-control/modbus-schema": "^0.1.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@effect/language-service": "^0.86.4",
    "@effect/platform-bun": "^0.90.0",
    "@types/bun": "latest",
    "effect": "^3.21.4",
    "fallow": "^2.104.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "effect": "^3.21.4"
  }
}
